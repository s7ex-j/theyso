<!-- Merge into android/app/src/main/AndroidManifest.xml after `flutter create` -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />          <!-- QR scanning -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />   <!-- high-risk approvals -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />    <!-- offline dictation -->

    <!-- Android 11+: lets speech_to_text find the on-device recognizer -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="Theyso"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- allowBackup=false: the device key must never leave this phone via cloud backup -->
    </application>
</manifest>

<!-- MainActivity: use platform/android/MainActivity.kt (FlutterFragmentActivity + FLAG_SECURE channel). -->
